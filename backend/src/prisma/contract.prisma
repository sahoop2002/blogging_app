// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
